{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "officer-preview": {
      "extends": "preview",
      "environment": "preview",
      "channel": "officer-preview",
      "env": {
        "APP_VARIANT": "officer"
      }
    },
    "officer-production": {
      "extends": "production",
      "environment": "production",
      "channel": "officer-production",
      "env": {
        "APP_VARIANT": "officer"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
