# Copy to .env (root) for database scripts. NEVER commit real values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server-side only, never in the mobile app
# Session-mode pooler (IPv4 friendly). Find it in Supabase > Connect.
DB_HOST=aws-1-REGION.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.YOUR-PROJECT-REF
DB_PASSWORD=
DB_NAME=postgres
